# Firebase Web App Configuration
# Obtain these from Firebase Console: Project Settings > General > Your Apps > Web App
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Backend & WebSocket URLs (For Cloud Production e.g. Render / Cloud Run / Railway)
# Leave empty for local development to use Vite proxy (port 5173 -> 5000 / 8000)
# VITE_API_BASE_URL=https://api.your-backend-domain.com
# VITE_FASTAPI_WS_URL=wss://fastapi.your-backend-domain.com
