# ── Multi-Modal Misinformation & Deepfake Detection Pipeline ──
# Project: main-link / detection-pipeline
# FORGE 48-Hour Build-a-thon

# ──── API Keys & Secrets ────
GEMINI_API_KEY=your_gemini_api_key_here

# ──── Vector DB ────
# Local FAISS is default; set QDRANT_URL for remote Qdrant
QDRANT_URL=
QDRANT_API_KEY=
FAISS_INDEX_PATH=./knowledge_base/faiss_index

# ──── Model Paths (HuggingFace) ────
EMBEDDING_MODEL=BAAI/bge-m3
NLI_MODEL=microsoft/deberta-v3-large-mnli
DEEPFAKE_VIDEO_MODEL=google/vit-base-patch16-224
DEEPFAKE_AUDIO_MODEL=facebook/wav2vec2-base
LANGUAGE_ID_MODEL=facebook/fasttext-language-identification

# ──── Thresholds ────
TAU_ENTAILMENT=0.75
TAU_CONTRADICTION=0.80
HYBRID_LAMBDA=0.7
RETRIEVAL_TOP_K=5

# ──── Server ────
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ──── Telegram Bot ────
TELEGRAM_BOT_TOKEN=

# ──── WhatsApp (Meta Cloud API) ────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ──── Paths ────
KNOWLEDGE_BASE_DIR=./knowledge_base
UPLOAD_DIR=./uploads
